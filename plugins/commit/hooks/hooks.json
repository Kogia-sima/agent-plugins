{
  "description": "commit スキルを読み込まずに git commit を実行しようとした場合にブロックする",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_commit_skill.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
