{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(claude --version)",
      "Bash(claude doctor)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(date:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install-hooks:*)",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(kill -9 -1)",
      "Bash(killall -9 *)",
      "Bash(pkill -9 -f .)",
      "Bash(shutdown -h now)",
      "Bash(shutdown -r now)",
      "Bash(poweroff)",
      "Bash(reboot)",
      "Bash(halt)",
      "Bash(systemctl poweroff)",
      "Bash(systemctl reboot)",
      "Bash(systemctl halt)",

      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm -Rf*)",
      "Bash(mv /* /dev/null)",
      "Bash(mv ~ /dev/null)",
      "Bash(perl -e 'unlink glob \"/*\"')",
      "Bash(find / -delete)",
      "Bash(find ~ -delete)",
      "Bash(find . -delete)",
      "Bash(find / -exec rm -rf {} \\;)",
      "Bash(find ~ -exec rm -rf {} \\;)",
      "Bash(find / -exec rm {} \\;)",
      "Bash(find ~ -exec rm {} \\;)",
      "Bash(yes | rm -rf /)",
      "Bash(yes | rm -rf ~)",
      "Bash(format c:)",
      "Bash(format /)",

      "Bash(shred -vfz /dev/sda)",
      "Bash(shred -vfz /dev/sdb)",
      "Bash(cat /dev/urandom > /dev/mem)",
      "Bash(crontab -r)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(eval *)",
      "Bash(exec *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fx*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git update-ref -d*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git checkout .)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(cat **/.env*)",
      "Bash(cat * **/.env*)",
      "Bash(head **/.env*)",
      "Bash(head * **/.env*)",
      "Bash(tail **/.env*)",
      "Bash(tail * **/.env*)",
      "Bash(grep **/.env*)",
      "Bash(grep * **/.env*)",
      "Bash(less **/.env*)",
      "Bash(less * **/.env*)",
      "Bash(more **/.env*)",
      "Bash(more * **/.env*)",
      "Bash(open **/.env*)",
      "Bash(open * **/.env*)",
      "Bash(env)",
      "Bash(env -S*)",
      "Bash(env --split-string*)",
      "Bash(env -C*)",
      "Bash(env --chdir*)",
      "Bash(printenv)",

      "Read(**/*.crt)",
      "Read(**/*.pem)",
      "Read(**/*.cer)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",

      "Edit(**/*.log)",
      "Edit(**/*.tmp)",
      "Edit(**/*.bak)",
      "Edit(**/*.backup)",
      "Edit(**/*.swp)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  }
}
